<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.sangeng.mapper.UserDao">
    <resultMap id="UserMap" type="com.sangeng.pojo.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="name" property="name"/>
        <result column="email" property="email"/>
        <result column="major" property="major"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="findById" resultMap="UserMap">SELECT * FROM user_account WHERE id=#{id}</select>
    <select id="findByUsername" resultMap="UserMap">SELECT * FROM user_account WHERE username=#{username}</select>
    <select id="findAll" resultMap="UserMap">SELECT * FROM user_account</select>
    
    <select id="findByRole" parameterType="String" resultMap="UserMap">
        SELECT * FROM user_account WHERE role=#{role}
    </select>

    <insert id="insert" parameterType="com.sangeng.pojo.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_account(username,password,role,name,email,major,create_time) VALUES(#{username},#{password},#{role},#{name},#{email},#{major},#{createTime})
    </insert>

    <update id="update" parameterType="com.sangeng.pojo.User">
        UPDATE user_account SET password=#{password}, role=#{role}, name=#{name}, email=#{email}, major=#{major} WHERE id=#{id}
    </update>
    
    <delete id="deleteById" parameterType="Integer">
        DELETE FROM user_account WHERE id=#{id}
    </delete>
</mapper>
