<?xml version="1.0" encoding="UTF-8" ?>
<!-- MyBatis映射文件DTD约束，定义了XML文件的合法元素和属性 -->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!-- mapper标签：映射文件的根元素，namespace属性指定对应的Mapper接口全路径 -->
<mapper namespace="com.sangeng.mapper.ThesisDao">
    
    <!-- resultMap标签：定义数据库查询结果与Java对象的映射关系 -->
    <!-- id属性：resultMap的唯一标识，供SQL语句引用 -->
    <!-- type属性：指定映射的Java实体类全路径 -->
    <resultMap id="ThesisMap" type="com.sangeng.pojo.Thesis">
        <!-- id标签：映射主键字段 -->
        <id column="id" property="id"/>
        <!-- result标签：映射普通字段，实现数据库字段到Java对象属性的驼峰映射 -->
        <result column="student_id" property="studentId"/><!-- 学生ID，驼峰映射 -->
        <result column="file_name" property="fileName"/><!-- 文件名，驼峰映射 -->
        <result column="file_path" property="filePath"/><!-- 文件路径，驼峰映射 -->
        <result column="status" property="status"/><!-- 论文状态（UPLOADED-已上传, REVIEWING-审核中, PASS-通过, REJECT-拒绝） -->
        <result column="upload_time" property="uploadTime"/><!-- 上传时间，驼峰映射 -->
        <result column="title" property="title"/><!-- 论文标题 -->
        <result column="project_id" property="projectId"/><!-- 关联的项目ID -->
        <result column="review_reason" property="reviewReason"/><!-- 审核原因，驼峰映射 -->
        <result column="score" property="score"/><!-- 评审分数 -->
        <result column="level" property="level"/><!-- 评审等级（EXCELLENT-优秀, GOOD-良好, AVERAGE-中等, PASS-及格, FAIL-不及格） -->
        <result column="review_comment" property="reviewComment"/><!-- 评审意见，驼峰映射 -->
        <result column="file_size" property="fileSize"/><!-- 文件大小，驼峰映射 -->
        <result column="file_type" property="fileType"/><!-- 文件类型 -->
    </resultMap>

    <!-- select标签：定义查询SQL -->
    <!-- id属性：对应Mapper接口中的方法名 -->
    <!-- resultMap属性：引用上面定义的resultMap -->
    <!-- 根据ID查询论文 -->
    <select id="findById" resultMap="ThesisMap">SELECT * FROM thesis WHERE id=#{id}</select>
    
    <!-- 根据学生ID查询该学生的所有论文 -->
    <select id="findByStudent" resultMap="ThesisMap">SELECT * FROM thesis WHERE student_id=#{studentId}</select>

    <!-- insert标签：定义插入SQL -->
    <!-- parameterType属性：指定传入参数的Java类型 -->
    <!-- useGeneratedKeys属性：启用自动生成主键 -->
    <!-- keyProperty属性：指定将自动生成的主键值赋给Java对象的哪个属性 -->
    <insert id="insert" parameterType="com.sangeng.pojo.Thesis" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO thesis(student_id,file_name,file_path,status,upload_time,title,project_id,review_reason,score,level,review_comment,file_size,file_type) 
        VALUES(#{studentId},#{fileName},#{filePath},#{status},#{uploadTime},#{title},#{projectId},#{reviewReason},#{score},#{level},#{reviewComment},#{fileSize},#{fileType})
    </insert>

    <!-- update标签：定义更新SQL -->
    <!-- 更新论文状态、审核原因、评审分数、评审等级和评审意见 -->
    <update id="updateStatus">
        UPDATE thesis 
        SET status=#{status}, 
            review_reason=#{reviewReason}, 
            score=#{score}, 
            level=#{level}, 
            review_comment=#{reviewComment} 
        WHERE id=#{id}
    </update>
    
    <!-- 查询所有待审核和审核中的论文 -->
    <!-- 状态为UPLOADED（已上传）或REVIEWING（审核中） -->
    <select id="findAllReviewing" resultMap="ThesisMap">
        SELECT * FROM thesis WHERE status='UPLOADED' OR status='REVIEWING'
    </select>
    
    <!-- 查询所有论文，按上传时间降序排列 -->
    <select id="findAll" resultMap="ThesisMap">
        SELECT * FROM thesis ORDER BY upload_time DESC
    </select>
    
    <!-- 更新论文的所有字段 -->
    <update id="update" parameterType="com.sangeng.pojo.Thesis">
        UPDATE thesis SET 
            title=#{title}, <!-- 论文标题 -->
            project_id=#{projectId}, <!-- 关联项目ID -->
            file_name=#{fileName}, <!-- 文件名 -->
            file_path=#{filePath}, <!-- 文件路径 -->
            status=#{status}, <!-- 论文状态 -->
            upload_time=#{uploadTime}, <!-- 上传时间 -->
            review_reason=#{reviewReason}, <!-- 审核原因 -->
            score=#{score}, <!-- 评审分数 -->
            level=#{level}, <!-- 评审等级 -->
            review_comment=#{reviewComment}, <!-- 评审意见 -->
            file_size=#{fileSize}, <!-- 文件大小 -->
            file_type=#{fileType} <!-- 文件类型 -->
        WHERE id=#{id} <!-- 条件：论文ID -->
    </update>
</mapper>

