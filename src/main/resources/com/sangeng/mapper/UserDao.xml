<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<!-- 
    UserMapper XML文件
    作用：定义UserDao接口的SQL实现
    说明：对应com.sangeng.mapper.UserDao接口
-->
<mapper namespace="com.sangeng.mapper.UserDao">
    <!-- 
        结果映射：user表到User实体类的映射
        id：映射ID，用于后续SQL语句引用
        type：目标实体类全路径
    -->
    <resultMap id="UserMap" type="com.sangeng.pojo.User">
        <!-- 主键映射 -->
        <id column="id" property="id"/>
        <!-- 普通字段映射：数据库列名 -> 实体类属性名 -->
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="name" property="name"/>
        <result column="email" property="email"/>
        <result column="major" property="major"/>
        <!-- 下划线转驼峰映射：create_time -> createTime -->
        <result column="create_time" property="createTime"/>
    </resultMap>

    <!-- 
        根据ID查询用户
        id：对应UserDao接口的findById方法
        resultMap：使用上面定义的UserMap映射结果
        SQL：从user_account表中查询指定ID的用户
    -->
    <select id="findById" resultMap="UserMap">
        SELECT * FROM user_account WHERE id=#{id}
    </select>
    
    <!-- 
        根据用户名查询用户
        id：对应UserDao接口的findByUsername方法
        resultMap：使用UserMap映射结果
        SQL：从user_account表中查询指定用户名的用户
    -->
    <select id="findByUsername" resultMap="UserMap">
        SELECT * FROM user_account WHERE username=#{username}
    </select>
    
    <!-- 
        查询所有用户
        id：对应UserDao接口的findAll方法
        resultMap：使用UserMap映射结果
        SQL：查询user_account表中的所有用户
    -->
    <select id="findAll" resultMap="UserMap">
        SELECT * FROM user_account
    </select>
    
    <!-- 
        根据角色查询用户
        id：对应UserDao接口的findByRole方法
        parameterType：参数类型为String
        resultMap：使用UserMap映射结果
        SQL：从user_account表中查询指定角色的用户
    -->
    <select id="findByRole" parameterType="String" resultMap="UserMap">
        SELECT * FROM user_account WHERE role=#{role}
    </select>

    <!-- 
        插入用户
        id：对应UserDao接口的insert方法
        parameterType：参数类型为User实体类
        useGeneratedKeys：使用数据库自增主键
        keyProperty：将自增主键值设置到User实体的id属性
        SQL：向user_account表插入新用户记录
    -->
    <insert id="insert" parameterType="com.sangeng.pojo.User" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_account(username,password,role,name,email,major,create_time) 
        VALUES(#{username},#{password},#{role},#{name},#{email},#{major},#{createTime})
    </insert>

    <!-- 
        更新用户信息
        id：对应UserDao接口的update方法
        parameterType：参数类型为User实体类
        SQL：更新user_account表中指定ID的用户信息
    -->
    <update id="update" parameterType="com.sangeng.pojo.User">
        UPDATE user_account 
        SET password=#{password}, role=#{role}, name=#{name}, email=#{email}, major=#{major} 
        WHERE id=#{id}
    </update>
    
    <!-- 
        根据ID删除用户
        id：对应UserDao接口的deleteById方法
        parameterType：参数类型为Integer
        SQL：从user_account表中删除指定ID的用户
    -->
    <delete id="deleteById" parameterType="Integer">
        DELETE FROM user_account WHERE id=#{id}
    </delete>
</mapper>
